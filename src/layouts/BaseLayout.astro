---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Aethos Tech Blog',
  description = 'Engineering blog. AI experiments. Micro SaaS learnings.',
  ogImage = '/og-default.png',
} = Astro.props;

const siteTitle = title === 'Aethos Tech Blog' ? title : `${title} — Aethos Tech`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Aethos Tech Blog" href="/rss.xml" />
    <title>{siteTitle}</title>
  </head>
  <body style="background: var(--color-background); color: var(--color-text); min-height: 100vh; display: flex; flex-direction: column;">

    <!-- Header -->
    <header style="position: sticky; top: 0; z-index: 50; border-bottom: 1px solid var(--color-border); background: hsl(0 0% 4% / 0.85); backdrop-filter: blur(12px);">
      <nav style="max-width: 800px; margin: 0 auto; padding: 0 1.5rem; height: 60px; display: flex; align-items: center; justify-content: space-between;">

        <!-- Logo → links back to main site -->
        <div style="display: flex; align-items: center; gap: 1.25rem;">
          <a
            href="https://aethostech.com.br"
            target="_blank"
            rel="noopener"
            style="font-family: var(--font-display); font-weight: 700; font-size: 1rem; color: var(--color-text); text-decoration: none; letter-spacing: -0.01em;"
          >
            Aethos Tech
          </a>
          <span style="color: var(--color-border); font-size: 1rem;">/</span>
          <a
            href="/"
            style="font-family: var(--font-display); font-weight: 500; font-size: 0.95rem; color: var(--color-text-muted); text-decoration: none;"
          >
            Blog
          </a>
        </div>

        <!-- Nav -->
        <div style="display: flex; align-items: center; gap: 1.25rem;">
          <a href="/" style="color: var(--color-text-muted); text-decoration: none; font-size: 0.875rem; font-weight: 400;">Posts</a>
          <a href="/about" style="color: var(--color-text-muted); text-decoration: none; font-size: 0.875rem; font-weight: 400;">About</a>
          <a
            href="/rss.xml"
            style="color: var(--color-text-muted); text-decoration: none; font-size: 0.875rem;"
            title="RSS Feed"
          >RSS</a>
          <button
            id="theme-toggle"
            aria-label="Toggle theme"
            style="background: var(--color-muted); border: 1px solid var(--color-border); border-radius: 6px; padding: 0.3rem 0.55rem; cursor: pointer; color: var(--color-text-muted); font-size: 0.8rem; line-height: 1;"
          >
            <span id="theme-icon">☀️</span>
          </button>
        </div>
      </nav>
    </header>

    <!-- Main content -->
    <main style="flex: 1; max-width: 800px; margin: 0 auto; padding: 3rem 1.5rem; width: 100%;">
      <slot />
    </main>

    <!-- Footer -->
    <footer style="border-top: 1px solid var(--color-border); padding: 2rem 1.5rem;">
      <div style="max-width: 800px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <span style="font-family: var(--font-display); font-size: 0.875rem; color: var(--color-text-muted);">
            © {new Date().getFullYear()} Aethos Tech
          </span>
        </div>
        <div style="display: flex; align-items: center; gap: 1.25rem;">
          <a
            href="https://aethostech.com.br"
            target="_blank"
            rel="noopener"
            style="font-size: 0.8rem; color: var(--color-text-muted); text-decoration: none;"
          >
            aethostech.com.br ↗
          </a>
          <a href="/rss.xml" style="font-size: 0.8rem; color: var(--color-text-muted); text-decoration: none;">RSS</a>
        </div>
      </div>
    </footer>

    <!-- Theme toggle script -->
    <script>
      const toggle = document.getElementById('theme-toggle');
      const icon = document.getElementById('theme-icon');
      const html = document.documentElement;

      const saved = localStorage.getItem('aethos-theme');
      if (saved === 'light') {
        html.classList.add('light');
        if (icon) icon.textContent = '🌙';
      }

      toggle?.addEventListener('click', () => {
        const isLight = html.classList.toggle('light');
        localStorage.setItem('aethos-theme', isLight ? 'light' : 'dark');
        if (icon) icon.textContent = isLight ? '🌙' : '☀️';
      });
    </script>
  </body>
</html>
