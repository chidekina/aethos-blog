---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  lang?: string;
  pubDate?: Date;
  tags?: string[];
  isArticle?: boolean;
  translationSlug?: string;
}

const {
  title = 'Aethos Tech Blog',
  description = 'Engineering blog. AI experiments. Micro SaaS learnings.',
  ogImage = '/og-default.png',
  lang = 'en',
  pubDate,
  tags = [],
  isArticle = false,
  translationSlug,
} = Astro.props;

const siteTitle = title === 'Aethos Tech Blog' ? title : `${title} — Aethos Tech`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const translationURL = translationSlug ? new URL(`/blog/${translationSlug}/`, Astro.site) : null;

// JSON-LD: WebSite schema (sitewide)
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Aethos Tech Blog',
  url: Astro.site?.toString(),
  description: 'Engineering blog. AI experiments. Micro SaaS learnings.',
  publisher: {
    '@type': 'Person',
    name: 'Cesar',
    url: 'https://github.com/chidekina',
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    {isArticle && pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {isArticle && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- hreflang -->
    <link rel="alternate" hreflang={lang} href={canonicalURL} />
    {translationURL && (
      <link rel="alternate" hreflang={lang === 'en' ? 'pt' : 'en'} href={translationURL} />
    )}
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
    <!-- JSON-LD sitewide -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <!-- JSON-LD per-page slot -->
    <slot name="head" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Aethos Tech Blog" href="/rss.xml" />
    <title>{siteTitle}</title>
  </head>
  <body style="background: var(--color-background); color: var(--color-text); min-height: 100vh; display: flex; flex-direction: column;">

    <!-- Star field background -->
    <canvas id="stars-canvas" aria-hidden="true" style="position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; opacity: 0.7;"></canvas>

    <!-- Skip to content (a11y) -->
    <a
      href="#main-content"
      style="position: absolute; left: -9999px; top: 1rem; z-index: 9999; background: var(--color-background); color: var(--color-text); padding: 0.5rem 1rem; border: 1px solid var(--color-border); border-radius: 6px; font-size: 0.875rem; text-decoration: none;"
      class="focus-skip"
    >
      <span data-i18n="skip">Skip to content</span>
    </a>

    <!-- Header -->
    <header style="position: sticky; top: 0; z-index: 50; border-bottom: 1px solid var(--color-border); background: var(--color-header-bg); backdrop-filter: blur(12px);">
      <nav
        aria-label="Main navigation"
        style="max-width: 800px; margin: 0 auto; padding: 0 1.5rem; height: 60px; display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;"
      >
        <!-- Breadcrumb logo -->
        <div style="display: flex; align-items: center; gap: 1.25rem; min-width: 0; flex: 1;">
          <a
            href="https://www.aethostech.com.br"
            target="_blank"
            rel="noopener noreferrer"
            style="font-family: var(--font-display); font-weight: 700; font-size: 1rem; color: var(--color-text); text-decoration: none; letter-spacing: -0.01em; white-space: nowrap; transition: color 150ms ease-out;"
            class="nav-logo"
          >
            Aethos Tech
          </a>
          <span aria-hidden="true" style="color: var(--color-border); flex-shrink: 0;">/</span>
          <a
            href="/"
            aria-current="page"
            style="font-family: var(--font-display); font-weight: 500; font-size: 0.95rem; color: var(--color-text-muted); text-decoration: none; white-space: nowrap; transition: color 150ms ease-out;"
            class="nav-logo-sub"
          >
            Blog
          </a>
        </div>

        <!-- Right controls: lang toggle (always visible) + hamburger (mobile only) -->
        <div style="display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0;">
          <!-- Language toggle — always visible, outside hamburger menu -->
          <button
            id="lang-toggle"
            data-translation-slug={translationSlug || ''}
            data-page-lang={lang}
            aria-label="Toggle language"
            style="background: var(--color-muted); border: 1px solid var(--color-border); border-radius: 6px; padding: 0.3rem 0.55rem; cursor: pointer; color: var(--color-text-muted); line-height: 1; transition: background 150ms ease-out, border-color 150ms ease-out; display: flex; align-items: center; gap: 0.2rem; font-size: 0.7rem; font-weight: 600; font-family: var(--font-mono);"
          >
            <span id="lang-en-label" style="transition: color 150ms ease-out;">EN</span>
            <span style="opacity: 0.3;">/</span>
            <span id="lang-pt-label" style="transition: color 150ms ease-out;">PT</span>
          </button>

          <!-- Mobile menu button (hidden on desktop via CSS) -->
          <button
            id="mobile-menu-btn"
            aria-label="Open navigation menu"
            aria-expanded="false"
            aria-controls="nav-links"
            style="display: none; background: none; border: 1px solid var(--color-border); border-radius: 6px; padding: 0.3rem 0.5rem; cursor: pointer; color: var(--color-text-muted); font-size: 1rem; line-height: 1; align-items: center; justify-content: center;"
          >☰</button>
        </div>

        <!-- Nav links -->
        <div class="nav-links" id="nav-links">
          <a href="/" class="nav-link" data-i18n="nav.posts">Posts</a>
          <a href="/about" class="nav-link" data-i18n="nav.about">About</a>
          <a href="/rss.xml" class="nav-link" title="Subscribe via RSS" aria-label="RSS Feed">RSS</a>
          <button
            id="theme-toggle"
            aria-label="Switch to light mode"
            aria-pressed="false"
            style="background: var(--color-muted); border: 1px solid var(--color-border); border-radius: 6px; padding: 0.3rem 0.55rem; cursor: pointer; color: var(--color-text-muted); line-height: 1; transition: background 150ms ease-out, border-color 150ms ease-out; display: flex; align-items: center; justify-content: center;"
          >
            <!-- Sun icon (shown in dark mode) -->
            <svg id="icon-sun" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"/><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"/><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/><line x1="4.93" y1="19.07" x2="7.76" y2="16.24"/><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"/>
            </svg>
            <!-- Moon icon (shown in light mode, hidden by default) -->
            <svg id="icon-moon" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <!-- Main content -->
    <main id="main-content" class="main-content" style="flex: 1; max-width: 800px; margin: 0 auto; padding: 3rem 1.5rem; width: 100%; position: relative; z-index: 1;">
      <slot />
    </main>

    <!-- Footer -->
    <footer style="border-top: 1px solid var(--color-border); padding: 2rem 1.5rem; position: relative; z-index: 1;">
      <div style="max-width: 800px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
        <span style="font-family: var(--font-display); font-size: 0.875rem; color: var(--color-text-muted);">
          © {new Date().getFullYear()} Aethos Tech
        </span>
        <div style="display: flex; align-items: center; gap: 1.25rem;">
          <a
            href="https://www.aethostech.com.br"
            target="_blank"
            rel="noopener noreferrer"
            class="nav-link"
            style="font-size: 0.8rem;"
          >
            aethostech.com.br ↗
          </a>
          <a href="/rss.xml" class="nav-link" style="font-size: 0.8rem;">RSS</a>
        </div>
      </div>
    </footer>

    <style>
      .focus-skip:focus-visible {
        left: 1rem !important;
      }
      .nav-logo:hover { color: hsl(0 0% 70%) !important; }
      .nav-logo-sub:hover { color: var(--color-text) !important; }
      .nav-links {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        flex-shrink: 0;
      }
      @media (max-width: 480px) {
        .nav-links {
          position: fixed;
          top: 60px;
          left: 0;
          right: 0;
          flex-direction: column;
          align-items: flex-start;
          gap: 0;
          background: var(--color-background);
          border-bottom: 1px solid var(--color-border);
          padding: 0.5rem 1.5rem 1rem;
          display: none;
          z-index: 49;
        }
        .nav-links.open { display: flex; }
        .nav-links .nav-link { padding: 0.5rem 0; font-size: 0.95rem; }
        #mobile-menu-btn { display: flex !important; }
      }
    </style>

    <script>
      // --- Language toggle ---
      const i18n: Record<string, Record<string, string>> = {
        en: {
          'nav.posts': 'Posts',
          'nav.about': 'About',
          'skip': 'Skip to content',
          'hero.description': 'Engineering blog. AI experiments. Micro SaaS learnings.',
          'filter.tags': 'Tags',
          'post.min-read': 'min read',
          'post.no-posts': 'No posts yet. Check back soon.',
          'post.no-results': 'No posts match this filter.',
          'post.part-of': 'Part of:',
          'post.series': 'Series:',
        },
        pt: {
          'nav.posts': 'Artigos',
          'nav.about': 'Sobre',
          'skip': 'Pular para o conteúdo',
          'hero.description': 'Blog de engenharia. Experimentos com IA. Aprendizados de Micro SaaS.',
          'filter.tags': 'Tags',
          'post.min-read': 'min de leitura',
          'post.no-posts': 'Nenhum post ainda. Volte em breve.',
          'post.no-results': 'Nenhum post encontrado para esse filtro.',
          'post.part-of': 'Parte de:',
          'post.series': 'Série:',
        },
      };

      const langToggle = document.getElementById('lang-toggle') as HTMLButtonElement | null;
      const pageLang = langToggle?.dataset.pageLang || 'en';
      const translationSlug = langToggle?.dataset.translationSlug || '';
      const langEnLabel = document.getElementById('lang-en-label') as HTMLElement | null;
      const langPtLabel = document.getElementById('lang-pt-label') as HTMLElement | null;

      let uiLang = localStorage.getItem('aethos-lang') || pageLang;

      function applyLang(lang: string) {
        uiLang = lang;
        localStorage.setItem('aethos-lang', lang);
        // Swap text nodes
        document.querySelectorAll('[data-i18n]').forEach((el) => {
          const key = (el as HTMLElement).dataset.i18n!;
          if (i18n[lang]?.[key]) el.textContent = i18n[lang][key];
        });
        // Show/hide full content blocks (e.g. about page)
        document.querySelectorAll<HTMLElement>('[data-lang-block]').forEach((el) => {
          el.style.display = el.dataset.langBlock === lang ? '' : 'none';
        });
        // Update toggle visual state
        const activeColor = 'var(--color-text)';
        const dimColor = 'var(--color-text-muted)';
        if (langEnLabel) langEnLabel.style.color = lang === 'en' ? activeColor : dimColor;
        if (langPtLabel) langPtLabel.style.color = lang === 'pt' ? activeColor : dimColor;
        // Notify other scripts (e.g. homepage post filter)
        document.dispatchEvent(new CustomEvent('aethos:lang-change', { detail: lang }));
      }

      applyLang(uiLang);

      langToggle?.addEventListener('click', () => {
        const newLang = uiLang === 'en' ? 'pt' : 'en';
        if (translationSlug && newLang !== pageLang) {
          localStorage.setItem('aethos-lang', newLang);
          window.location.href = `/blog/${translationSlug}/`;
        } else {
          applyLang(newLang);
        }
      });

      // --- Theme toggle ---
      const toggle = document.getElementById('theme-toggle') as HTMLButtonElement | null;
      const iconSun = document.getElementById('icon-sun') as SVGElement | null;
      const iconMoon = document.getElementById('icon-moon') as SVGElement | null;
      const html = document.documentElement;
      const metaTheme = document.querySelector('meta[name="theme-color"]');

      function applyTheme(isLight: boolean) {
        if (isLight) {
          html.classList.add('light');
        } else {
          html.classList.remove('light');
        }
        if (iconSun) iconSun.style.display = isLight ? 'none' : '';
        if (iconMoon) iconMoon.style.display = isLight ? '' : 'none';
        if (toggle) {
          toggle.setAttribute('aria-pressed', String(isLight));
          toggle.setAttribute('aria-label', isLight ? 'Switch to dark mode' : 'Switch to light mode');
        }
        if (metaTheme) {
          metaTheme.setAttribute('content', isLight ? '#fafafa' : '#0a0a0a');
        }
      }

      // Restore saved preference
      const saved = localStorage.getItem('aethos-theme');
      applyTheme(saved === 'light');

      toggle?.addEventListener('click', () => {
        const isLight = !html.classList.contains('light');
        localStorage.setItem('aethos-theme', isLight ? 'light' : 'dark');
        applyTheme(isLight);
      });

      // Mobile menu
      const mobileBtn = document.getElementById('mobile-menu-btn') as HTMLButtonElement | null;
      const navLinks = document.getElementById('nav-links');
      mobileBtn?.addEventListener('click', () => {
        const isOpen = navLinks?.classList.toggle('open') ?? false;
        mobileBtn.setAttribute('aria-expanded', String(isOpen));
        mobileBtn.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');
      });
    </script>

    <!-- Stars & shooting stars background -->
    <script>
      (function () {
        const canvas = document.getElementById('stars-canvas') as HTMLCanvasElement | null;
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        let W = 0, H = 0;

        function rand(a: number, b: number) { return a + Math.random() * (b - a); }
        function isLight() { return document.documentElement.classList.contains('light'); }

        // ── Dark mode: stars + shooting stars ──────────────────────────
        interface Star {
          x: number; y: number; r: number;
          alpha: number; aDir: number; aSpd: number;
        }
        interface Shooter {
          x: number; y: number; vx: number; vy: number;
          trail: { x: number; y: number }[]; trailLen: number;
          life: number; maxLife: number;
        }

        const stars: Star[] = [];
        const shooters: Shooter[] = [];
        let nextShot = 0;

        function initStars() {
          stars.length = 0;
          for (let i = 0; i < 160; i++) {
            stars.push({ x: rand(0,W), y: rand(0,H), r: rand(0.4,1.7),
              alpha: rand(0.2,1), aDir: Math.random()>.5?1:-1, aSpd: rand(0.002,0.008) });
          }
        }

        function spawnShooter() {
          const a = rand(Math.PI*.1, Math.PI*.4), spd = rand(6,14);
          shooters.push({ x: rand(0,W*.8), y: rand(0,H*.3), vx: Math.cos(a)*spd, vy: Math.sin(a)*spd,
            trail: [], trailLen: rand(80,180), life: 0, maxLife: rand(40,70) });
        }

        function drawDark(ts: number) {
          for (const s of stars) {
            s.alpha += s.aDir * s.aSpd;
            if (s.alpha>=1){s.alpha=1;s.aDir=-1;} if (s.alpha<=0.1){s.alpha=0.1;s.aDir=1;}
            ctx!.beginPath(); ctx!.arc(s.x,s.y,s.r,0,Math.PI*2);
            ctx!.fillStyle = `rgba(255,255,255,${s.alpha*.85})`; ctx!.fill();
          }
          if (ts > nextShot && shooters.length < 3) { spawnShooter(); nextShot = ts + rand(2500,6000); }
          for (let i = shooters.length-1; i>=0; i--) {
            const s = shooters[i];
            s.trail.push({x:s.x, y:s.y}); s.x+=s.vx; s.y+=s.vy; s.life++;
            const fade = 1 - s.life/s.maxLife;
            const t0 = Math.max(0, s.trail.length - Math.round(s.trailLen/4));
            if (s.trail.length>1) {
              const tail=s.trail[t0];
              const g = ctx!.createLinearGradient(tail.x,tail.y,s.x,s.y);
              g.addColorStop(0,`rgba(220,240,255,0)`); g.addColorStop(1,`rgba(220,240,255,${fade*.9})`);
              ctx!.beginPath(); ctx!.moveTo(tail.x,tail.y);
              for (let j=t0+1;j<s.trail.length;j++) ctx!.lineTo(s.trail[j].x,s.trail[j].y);
              ctx!.lineTo(s.x,s.y); ctx!.strokeStyle=g; ctx!.lineWidth=1.5; ctx!.stroke();
            }
            if (s.life>=s.maxLife||s.x>W+100||s.y>H+100) shooters.splice(i,1);
          }
        }

        // ── Light mode: floating dust motes / pollen ───────────────────
        interface Mote {
          x: number; y: number; r: number;
          vx: number; vy: number;
          alpha: number; aDir: number; aSpd: number;
          hue: number;
        }

        const motes: Mote[] = [];

        function initMotes() {
          motes.length = 0;
          // warm golden/amber/lavender palette
          const hues = [40, 50, 200, 270, 30, 60];
          for (let i = 0; i < 90; i++) {
            motes.push({
              x: rand(0,W), y: rand(0,H),
              r: rand(1.5, 4.5),
              vx: rand(-0.12, 0.12), vy: rand(-0.18, -0.04), // drift upward gently
              alpha: rand(0.05, 0.35),
              aDir: Math.random()>.5?1:-1, aSpd: rand(0.001,0.004),
              hue: hues[Math.floor(Math.random()*hues.length)] + rand(-15,15),
            });
          }
        }

        function drawLight() {
          for (const m of motes) {
            // drift
            m.x += m.vx; m.y += m.vy;
            // wrap around
            if (m.x < -10) m.x = W+10; if (m.x > W+10) m.x = -10;
            if (m.y < -10) { m.y = H+10; m.x = rand(0,W); }
            // pulse
            m.alpha += m.aDir * m.aSpd;
            if (m.alpha >= 0.35){m.alpha=0.35;m.aDir=-1;} if (m.alpha<=0.03){m.alpha=0.03;m.aDir=1;}

            // soft glowing dot with radial gradient
            const g = ctx!.createRadialGradient(m.x,m.y,0, m.x,m.y,m.r*2.5);
            g.addColorStop(0, `hsla(${m.hue},70%,55%,${m.alpha})`);
            g.addColorStop(1, `hsla(${m.hue},70%,55%,0)`);
            ctx!.beginPath(); ctx!.arc(m.x,m.y,m.r*2.5,0,Math.PI*2);
            ctx!.fillStyle = g; ctx!.fill();
          }
        }

        // ── Canvas opacity cross-fade on theme switch ──────────────────
        let canvasOpacity = 1;
        let fadeTarget = 1;
        let fadeFrom = 1;
        let fadeProgress = 1;
        const FADE_DUR = 30; // frames

        function startFade() {
          fadeFrom = canvasOpacity;
          fadeTarget = 0;
          fadeProgress = 0;
        }
        function completeFade() {
          // reinit for new mode, then fade back in
          if (isLight()) initMotes(); else initStars();
          shooters.length = 0;
          fadeFrom = 0; fadeTarget = 1; fadeProgress = 0;
        }

        // Watch for theme class changes
        const observer = new MutationObserver(() => startFade());
        observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

        // ── Main loop ──────────────────────────────────────────────────
        function resize() {
          W = canvas!.width = window.innerWidth;
          H = canvas!.height = window.innerHeight;
          if (isLight()) initMotes(); else initStars();
        }

        function draw(ts: number) {
          ctx!.clearRect(0, 0, W, H);

          // Manage cross-fade
          if (fadeProgress < FADE_DUR) {
            fadeProgress++;
            const t = fadeProgress / FADE_DUR;
            canvasOpacity = fadeFrom + (fadeTarget - fadeFrom) * (t < 0.5 ? 2*t*t : -1+(4-2*t)*t);
            canvas!.style.opacity = String(canvasOpacity * 0.75);
            if (fadeProgress === FADE_DUR && fadeTarget === 0) completeFade();
          }

          if (isLight()) drawLight(); else drawDark(ts);

          requestAnimationFrame(draw);
        }

        resize();
        window.addEventListener('resize', () => { resize(); });
        requestAnimationFrame(draw);
      })();
    </script>
  </body>
</html>
