---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  lang?: string;
  pubDate?: Date;
  tags?: string[];
  isArticle?: boolean;
  translationSlug?: string;
}

const {
  title = 'Aethos Tech Blog',
  description = 'Engineering blog. AI experiments. Micro SaaS learnings.',
  ogImage = '/og-default.png',
  lang = 'en',
  pubDate,
  tags = [],
  isArticle = false,
  translationSlug,
} = Astro.props;

const siteTitle = title === 'Aethos Tech Blog' ? title : `${title} — Aethos Tech`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const translationURL = translationSlug ? new URL(`/blog/${translationSlug}/`, Astro.site) : null;

// JSON-LD: WebSite schema (sitewide)
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Aethos Tech Blog',
  url: Astro.site?.toString(),
  description: 'Engineering blog. AI experiments. Micro SaaS learnings.',
  publisher: {
    '@type': 'Person',
    name: 'Cesar',
    url: 'https://github.com/chidekina',
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    {isArticle && pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {isArticle && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- hreflang -->
    <link rel="alternate" hreflang={lang} href={canonicalURL} />
    {translationURL && (
      <link rel="alternate" hreflang={lang === 'en' ? 'pt' : 'en'} href={translationURL} />
    )}
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
    <!-- JSON-LD sitewide -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <!-- JSON-LD per-page slot -->
    <slot name="head" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Aethos Tech Blog" href="/rss.xml" />
    <title>{siteTitle}</title>
  </head>
  <body style="background: var(--color-background); color: var(--color-text); min-height: 100vh; display: flex; flex-direction: column;">

    <!-- Skip to content (a11y) -->
    <a
      href="#main-content"
      style="position: absolute; left: -9999px; top: 1rem; z-index: 9999; background: var(--color-background); color: var(--color-text); padding: 0.5rem 1rem; border: 1px solid var(--color-border); border-radius: 6px; font-size: 0.875rem; text-decoration: none;"
      class="focus-skip"
    >
      Skip to content
    </a>

    <!-- Header -->
    <header style="position: sticky; top: 0; z-index: 50; border-bottom: 1px solid var(--color-border); background: var(--color-header-bg); backdrop-filter: blur(12px);">
      <nav
        aria-label="Main navigation"
        style="max-width: 800px; margin: 0 auto; padding: 0 1.5rem; height: 60px; display: flex; align-items: center; justify-content: space-between;"
      >
        <!-- Breadcrumb logo -->
        <div style="display: flex; align-items: center; gap: 1.25rem; min-width: 0;">
          <a
            href="https://www.aethostech.com.br"
            target="_blank"
            rel="noopener noreferrer"
            style="font-family: var(--font-display); font-weight: 700; font-size: 1rem; color: var(--color-text); text-decoration: none; letter-spacing: -0.01em; white-space: nowrap; transition: color 150ms ease-out;"
            class="nav-logo"
          >
            Aethos Tech
          </a>
          <span aria-hidden="true" style="color: var(--color-border); flex-shrink: 0;">/</span>
          <a
            href="/"
            aria-current="page"
            style="font-family: var(--font-display); font-weight: 500; font-size: 0.95rem; color: var(--color-text-muted); text-decoration: none; white-space: nowrap; transition: color 150ms ease-out;"
            class="nav-logo-sub"
          >
            Blog
          </a>
        </div>

        <!-- Mobile menu button (hidden on desktop via CSS) -->
        <button
          id="mobile-menu-btn"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="nav-links"
          style="display: none; background: none; border: 1px solid var(--color-border); border-radius: 6px; padding: 0.3rem 0.5rem; cursor: pointer; color: var(--color-text-muted); font-size: 1rem; line-height: 1; align-items: center; justify-content: center;"
        >☰</button>

        <!-- Nav links -->
        <div class="nav-links" id="nav-links">
          <a href="/" class="nav-link">Posts</a>
          <a href="/about" class="nav-link">About</a>
          <a href="/rss.xml" class="nav-link" title="Subscribe via RSS" aria-label="RSS Feed">RSS</a>
          <button
            id="theme-toggle"
            aria-label="Switch to light mode"
            aria-pressed="false"
            style="background: var(--color-muted); border: 1px solid var(--color-border); border-radius: 6px; padding: 0.3rem 0.55rem; cursor: pointer; color: var(--color-text-muted); line-height: 1; transition: background 150ms ease-out, border-color 150ms ease-out; display: flex; align-items: center; justify-content: center;"
          >
            <!-- Sun icon (shown in dark mode) -->
            <svg id="icon-sun" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"/><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"/><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/><line x1="4.93" y1="19.07" x2="7.76" y2="16.24"/><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"/>
            </svg>
            <!-- Moon icon (shown in light mode, hidden by default) -->
            <svg id="icon-moon" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <!-- Main content -->
    <main id="main-content" style="flex: 1; max-width: 800px; margin: 0 auto; padding: 3rem 1.5rem; width: 100%;">
      <slot />
    </main>

    <!-- Footer -->
    <footer style="border-top: 1px solid var(--color-border); padding: 2rem 1.5rem;">
      <div style="max-width: 800px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
        <span style="font-family: var(--font-display); font-size: 0.875rem; color: var(--color-text-muted);">
          © {new Date().getFullYear()} Aethos Tech
        </span>
        <div style="display: flex; align-items: center; gap: 1.25rem;">
          <a
            href="https://www.aethostech.com.br"
            target="_blank"
            rel="noopener noreferrer"
            class="nav-link"
            style="font-size: 0.8rem;"
          >
            aethostech.com.br ↗
          </a>
          <a href="/rss.xml" class="nav-link" style="font-size: 0.8rem;">RSS</a>
        </div>
      </div>
    </footer>

    <style>
      .focus-skip:focus-visible {
        left: 1rem !important;
      }
      .nav-logo:hover { color: hsl(0 0% 70%) !important; }
      .nav-logo-sub:hover { color: var(--color-text) !important; }
      .nav-links {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        flex-shrink: 0;
      }
      @media (max-width: 480px) {
        .nav-links {
          position: fixed;
          top: 60px;
          left: 0;
          right: 0;
          flex-direction: column;
          align-items: flex-start;
          gap: 0;
          background: var(--color-background);
          border-bottom: 1px solid var(--color-border);
          padding: 0.5rem 1.5rem 1rem;
          display: none;
          z-index: 49;
        }
        .nav-links.open { display: flex; }
        .nav-links .nav-link { padding: 0.5rem 0; font-size: 0.95rem; }
        #mobile-menu-btn { display: flex !important; }
      }
    </style>

    <script>
      const toggle = document.getElementById('theme-toggle') as HTMLButtonElement | null;
      const iconSun = document.getElementById('icon-sun') as SVGElement | null;
      const iconMoon = document.getElementById('icon-moon') as SVGElement | null;
      const html = document.documentElement;
      const metaTheme = document.querySelector('meta[name="theme-color"]');

      function applyTheme(isLight: boolean) {
        if (isLight) {
          html.classList.add('light');
        } else {
          html.classList.remove('light');
        }
        if (iconSun) iconSun.style.display = isLight ? 'none' : '';
        if (iconMoon) iconMoon.style.display = isLight ? '' : 'none';
        if (toggle) {
          toggle.setAttribute('aria-pressed', String(isLight));
          toggle.setAttribute('aria-label', isLight ? 'Switch to dark mode' : 'Switch to light mode');
        }
        if (metaTheme) {
          metaTheme.setAttribute('content', isLight ? '#fafafa' : '#0a0a0a');
        }
      }

      // Restore saved preference
      const saved = localStorage.getItem('aethos-theme');
      applyTheme(saved === 'light');

      toggle?.addEventListener('click', () => {
        const isLight = !html.classList.contains('light');
        localStorage.setItem('aethos-theme', isLight ? 'light' : 'dark');
        applyTheme(isLight);
      });

      // Mobile menu
      const mobileBtn = document.getElementById('mobile-menu-btn') as HTMLButtonElement | null;
      const navLinks = document.getElementById('nav-links');
      mobileBtn?.addEventListener('click', () => {
        const isOpen = navLinks?.classList.toggle('open') ?? false;
        mobileBtn.setAttribute('aria-expanded', String(isOpen));
        mobileBtn.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');
      });
    </script>
  </body>
</html>
