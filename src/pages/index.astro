---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import readingTime from 'reading-time';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<BaseLayout>
  <!-- Hero -->
  <div style="margin-bottom: 3rem; padding-bottom: 2rem; border-bottom: 1px solid var(--color-border);">
    <h1 style="font-size: 1.75rem; font-weight: 800; color: var(--color-text); margin-bottom: 0.6rem; letter-spacing: -0.02em;">
      Aethos Tech
    </h1>
    <p style="color: var(--color-text-muted); font-size: 1rem; max-width: 48ch; line-height: 1.6;" data-i18n="hero.description">
      Engineering blog. AI experiments. Micro SaaS learnings.
    </p>
  </div>

  <!-- Search -->
  <div style="margin-bottom: 1.25rem;">
    <label for="post-search" class="sr-only" data-i18n="search.label">Search posts</label>
    <input
      type="search"
      id="post-search"
      autocomplete="off"
      placeholder="Search posts…"
      data-i18n-placeholder="search.placeholder"
      aria-describedby="search-status"
      style="width: 100%; box-sizing: border-box; font-family: var(--font-mono); font-size: 0.85rem; color: var(--color-text); background: var(--color-muted); border: 1px solid var(--color-border); border-radius: 6px; padding: 0.6rem 0.7rem; min-height: 44px;"
    />
    <p id="search-status" role="status" aria-live="polite" style="font-size: 0.72rem; color: var(--color-text-muted); margin: 0.4rem 0 0; min-height: 1em;"></p>
  </div>

  <!-- Filters -->
  {allTags.length > 0 && (
    <div id="filters" style="margin-bottom: 2rem;" role="search" aria-label="Filter posts">
      <div style="display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap;">
        <span style="font-size: 0.7rem; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin-right: 0.25rem;" data-i18n="filter.tags">
          Tags
        </span>
        {allTags.slice(0, 8).map((tag) => (
          <button
            class="tag-filter-btn"
            data-tag={tag}
            data-active="false"
            aria-pressed="false"
            aria-label={`Filter by ${tag}`}
          >
            #{tag}
          </button>
        ))}
        {allTags.length > 8 && (
          <>
            <div id="tags-overflow" style="display: none; align-items: center; gap: 0.4rem; flex-wrap: wrap;">
              {allTags.slice(8).map((tag) => (
                <button
                  class="tag-filter-btn"
                  data-tag={tag}
                  data-active="false"
                  aria-pressed="false"
                  aria-label={`Filter by ${tag}`}
                >
                  #{tag}
                </button>
              ))}
            </div>
            <button
              id="tags-more-btn"
              aria-expanded="false"
              style="font-size: 0.7rem; font-weight: 600; font-family: var(--font-mono); background: var(--color-muted); border: 1px solid var(--color-border); border-radius: 4px; padding: 0.2rem 0.45rem; cursor: pointer; color: var(--color-text-muted); transition: background 150ms ease-out, color 150ms ease-out;"
            >
              +{allTags.length - 8} more
            </button>
          </>
        )}
      </div>
    </div>
  )}

  <!-- Post List -->
  <div id="post-list" role="list" aria-label="Blog posts">
    {posts.length === 0 ? (
      <p style="color: var(--color-text-muted); text-align: center; padding: 3rem 0;" data-i18n="post.no-posts">No posts yet. Check back soon.</p>
    ) : (
      posts.map((post) => {
        const rt = Math.ceil(readingTime(post.body).minutes);
        const isoDate = post.data.date.toISOString().split('T')[0];
        const displayDate = post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
        return (
          <article
            class="post-item"
            data-lang={post.data.lang}
            data-slug={post.slug}
            data-tags={post.data.tags.join(',')}
            style="padding: 1.5rem 0; border-bottom: 1px solid var(--color-border);"
            role="listitem"
          >
            <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 0.4rem;">
              <a href={`/blog/${post.slug}`} class="post-link" style="flex: 1; min-width: 0;">
                <h2 style="font-size: 1.05rem; font-weight: 700; margin: 0; line-height: 1.4; font-family: var(--font-display);">
                  {post.data.title}
                </h2>
              </a>
              <span class="lang-badge" aria-label={`Language: ${post.data.lang.toUpperCase()}`}>
                {post.data.lang.toUpperCase()}
              </span>
            </div>

            <p style="color: var(--color-text-muted); font-size: 0.875rem; margin: 0 0 0.75rem; line-height: 1.65;">
              {post.data.description}
            </p>

            <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
              <time datetime={isoDate} style="font-size: 0.8rem; color: var(--color-text-muted);">{displayDate}</time>
              <span aria-hidden="true" style="color: var(--color-border);">·</span>
              <span style="font-size: 0.8rem; color: var(--color-text-muted);">{rt} <span data-i18n="post.min-read">min read</span></span>
              {post.data.tags.length > 0 && (
                <>
                  <span aria-hidden="true" style="color: var(--color-border);">·</span>
                  <div class="post-tags-row" style="display: flex; gap: 0.3rem; flex-wrap: wrap; align-items: center;">
                    {post.data.tags.slice(0, 2).map((tag) => (
                      <span style="font-size: 0.7rem; color: var(--color-text-muted); background: var(--color-muted); border: 1px solid var(--color-border); border-radius: 4px; padding: 0.15rem 0.4rem;">
                        #{tag}
                      </span>
                    ))}
                    {post.data.tags.length > 2 && (
                      <>
                        <span class="post-tags-hidden" style="display: none; gap: 0.3rem; flex-wrap: wrap;">
                          {post.data.tags.slice(2).map((tag) => (
                            <span style="font-size: 0.7rem; color: var(--color-text-muted); background: var(--color-muted); border: 1px solid var(--color-border); border-radius: 4px; padding: 0.15rem 0.4rem;">
                              #{tag}
                            </span>
                          ))}
                        </span>
                        <button
                          class="post-tags-more"
                          aria-expanded="false"
                          style="font-size: 0.65rem; font-weight: 600; font-family: var(--font-mono); background: none; border: 1px solid var(--color-border); border-radius: 4px; padding: 0.15rem 0.35rem; cursor: pointer; color: var(--color-text-muted); transition: background 150ms ease-out, color 150ms ease-out;"
                        >
                          +{post.data.tags.length - 2}
                        </button>
                      </>
                    )}
                  </div>
                </>
              )}
            </div>
          </article>
        );
      })
    )}
  </div>

  <div id="no-results" hidden style="color: var(--color-text-muted); text-align: center; padding: 3rem 0;" data-i18n="post.no-results">
    No posts match this filter.
  </div>
</BaseLayout>

<script>
  const tagBtns   = document.querySelectorAll<HTMLButtonElement>('.tag-filter-btn');
  const items     = document.querySelectorAll<HTMLElement>('.post-item');
  const noResults = document.getElementById('no-results');

  // Lang comes from the header toggle preference
  let activeLang = localStorage.getItem('aethos-lang') || 'all';
  let activeTag = new URLSearchParams(window.location.search).get('tag') || '';

  const searchInput = document.getElementById('post-search') as HTMLInputElement | null;
  const searchStatus = document.getElementById('search-status');
  let activeQuery = (new URLSearchParams(window.location.search).get('q') || '').trim();

  // slug -> full lowercased text. Null until /search-index.json has loaded.
  let index: Map<string, string> | null = null;
  let indexState: 'idle' | 'loading' | 'ready' | 'failed' = 'idle';

  // Body text is NOT in this page's markup — inlining it would roughly triple
  // the homepage. Until the index arrives a query cannot be answered, and
  // answering it from titles alone would produce confident false "no results"
  // for terms that are in the posts. So the status line says which state we are
  // in rather than silently showing a wrong list.
  async function loadIndex() {
    if (indexState === 'loading' || indexState === 'ready') return;
    indexState = 'loading';
    setStatus();
    try {
      const res = await fetch('/search-index.json');
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const rows: Array<{ slug: string; text: string }> = await res.json();
      index = new Map(rows.map((r) => [r.slug, r.text]));
      indexState = 'ready';
    } catch {
      index = null;
      indexState = 'failed';
    }
    applyFilters();
  }

  function statusText(visible: number): string {
    const lang = localStorage.getItem('aethos-lang') || 'en';
    const pt = lang === 'pt';
    if (!activeQuery) return '';
    if (indexState === 'loading') return pt ? 'Carregando busca…' : 'Loading search…';
    if (indexState === 'failed') {
      return pt
        ? 'Busca indisponível — o índice não carregou. Os filtros por tag continuam funcionando.'
        : 'Search unavailable — the index failed to load. Tag filters still work.';
    }
    if (visible === 1) return pt ? '1 artigo encontrado' : '1 post found';
    return pt ? `${visible} artigos encontrados` : `${visible} posts found`;
  }

  function setStatus(visible = 0) {
    if (searchStatus) searchStatus.textContent = statusText(visible);
  }

  function setBtn(btn: HTMLButtonElement, active: boolean) {
    btn.dataset.active = String(active);
    btn.setAttribute('aria-pressed', String(active));
  }

  function applyFilters() {
    let visible = 0;
    items.forEach((item) => {
      const lang = item.dataset.lang ?? '';
      const tags = item.dataset.tags?.split(',') ?? [];
      const slug = item.dataset.slug ?? '';
      // A pending or failed index must not silently filter the list down.
      const matchesQuery =
        !activeQuery || indexState !== 'ready' || (index?.get(slug) ?? '').includes(activeQuery.toLowerCase());
      const show =
        (activeLang === 'all' || lang === activeLang) &&
        (!activeTag || tags.includes(activeTag)) &&
        matchesQuery;
      item.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    if (noResults) noResults.hidden = visible !== 0;

    setStatus(visible);

    const p = new URLSearchParams();
    if (activeTag) p.set('tag', activeTag);
    if (activeQuery) p.set('q', activeQuery);
    const qs = p.toString();
    history.replaceState(null, '', qs ? `?${qs}` : window.location.pathname);
  }

  tagBtns.forEach((btn) => btn.addEventListener('click', () => {
    const tag = btn.dataset.tag ?? '';
    activeTag = activeTag === tag ? '' : tag;
    tagBtns.forEach((b) => setBtn(b, b.dataset.tag === activeTag));
    applyFilters();
  }));

  if (searchInput) {
    searchInput.value = activeQuery;
    searchInput.addEventListener('focus', loadIndex, { once: true });
    searchInput.addEventListener('input', () => {
      activeQuery = searchInput.value.trim();
      if (activeQuery) loadIndex();
      applyFilters();
    });
  }

  tagBtns.forEach((b) => setBtn(b, b.dataset.tag === activeTag));
  // A shared ?q= link must work without waiting for a focus that never comes.
  if (activeQuery) loadIndex();
  applyFilters();

  // Re-filter when header lang toggle fires
  document.addEventListener('aethos:lang-change', (e) => {
    activeLang = (e as CustomEvent<string>).detail;
    applyFilters();
  });

  // Filter bar: expand/collapse overflow tags
  const tagsMoreBtn = document.getElementById('tags-more-btn') as HTMLButtonElement | null;
  const tagsOverflow = document.getElementById('tags-overflow') as HTMLElement | null;
  tagsMoreBtn?.addEventListener('click', () => {
    const expanded = tagsMoreBtn.getAttribute('aria-expanded') === 'true';
    if (!tagsMoreBtn.dataset.label) tagsMoreBtn.dataset.label = tagsMoreBtn.textContent!.trim();
    tagsOverflow!.style.display = expanded ? 'none' : 'flex';
    tagsMoreBtn.setAttribute('aria-expanded', String(!expanded));
    tagsMoreBtn.textContent = expanded ? tagsMoreBtn.dataset.label! : 'less';
  });

  // Per-post tags: expand/collapse
  document.querySelectorAll<HTMLButtonElement>('.post-tags-more').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      const hidden = btn.previousElementSibling as HTMLElement | null;
      if (hidden) hidden.style.display = expanded ? 'none' : 'flex';
      btn.setAttribute('aria-expanded', String(!expanded));
      if (!btn.dataset.originalText) btn.dataset.originalText = btn.textContent!.trim();
      btn.textContent = expanded ? btn.dataset.originalText! : 'less';
    });
  });
</script>
