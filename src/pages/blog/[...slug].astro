---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import readingTime from 'reading-time';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props;
const { Content } = await post.render();

const stats = readingTime(post.body);
const readTime = Math.ceil(stats.minutes);
const isoDate = post.data.date.toISOString().split('T')[0];
const formattedDate = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric', month: 'short', day: 'numeric',
});

// Series navigation
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const seriesPosts = post.data.series
  ? allPosts
      .filter((p) => p.data.series === post.data.series)
      .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  : [];

const seriesIndex = seriesPosts.findIndex((p) => p.slug === post.slug);
const prevPost = seriesIndex > 0 ? seriesPosts[seriesIndex - 1] : null;
const nextPost = seriesIndex < seriesPosts.length - 1 ? seriesPosts[seriesIndex + 1] : null;

const ogImage = `/og/${post.slug}.png`;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={ogImage}
  lang={post.data.lang}
>
  <article>
    <!-- Post Header -->
    <header style="margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-border);">
      <h1 style="font-size: 2rem; font-weight: 800; line-height: 1.2; margin-bottom: 1rem; color: var(--color-text); letter-spacing: -0.02em;">
        {post.data.title}
      </h1>

      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; margin-bottom: 1rem;">
        <time datetime={isoDate} style="color: var(--color-text-muted); font-size: 0.875rem;">
          {formattedDate}
        </time>
        <span aria-hidden="true" style="color: var(--color-border);">·</span>
        <span style="color: var(--color-text-muted); font-size: 0.875rem;">{readTime} min read</span>
        <span aria-hidden="true" style="color: var(--color-border);">·</span>
        <span class="lang-badge" aria-label={`Language: ${post.data.lang.toUpperCase()}`}>
          {post.data.lang.toUpperCase()}
        </span>
      </div>

      {post.data.series && (
        <p style="font-size: 0.8rem; color: var(--color-text-muted); margin-bottom: 1rem;">
          Part of: <span style="color: var(--color-primary); font-style: italic;">{post.data.series}</span>
        </p>
      )}

      <div style="display: flex; flex-wrap: wrap; gap: 0.4rem;" aria-label="Post tags">
        {post.data.tags.map((tag) => (
          <a href={`/?tag=${tag}`} class="tag-link">
            #{tag}
          </a>
        ))}
      </div>
    </header>

    <!-- Post Content -->
    <div class="prose">
      <Content />
    </div>

    <!-- Series Navigation -->
    {seriesPosts.length > 1 && (
      <nav aria-label={`Series: ${post.data.series}`} style="margin-top: 3rem; padding: 1.5rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 8px;">
        <p style="font-size: 0.7rem; color: var(--color-text-muted); margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 0.08em;">
          Series: {post.data.series}
        </p>
        <ol style="list-style: none; padding: 0; margin: 0 0 1.25rem;">
          {seriesPosts.map((p, i) => (
            <li style="padding: 0.3rem 0; font-size: 0.9rem;">
              <span aria-hidden="true" style="color: var(--color-text-muted); margin-right: 0.4rem;">{i + 1}.</span>
              {p.slug === post.slug ? (
                <strong style="color: var(--color-text);" aria-current="true">{p.data.title}</strong>
              ) : (
                <a href={`/blog/${p.slug}`} class="post-link">{p.data.title}</a>
              )}
            </li>
          ))}
        </ol>
        <div style="display: flex; justify-content: space-between; gap: 1rem; padding-top: 1rem; border-top: 1px solid var(--color-border);">
          {prevPost ? (
            <a href={`/blog/${prevPost.slug}`} class="nav-link" style="font-size: 0.875rem;" rel="prev">
              ← {prevPost.data.title}
            </a>
          ) : <span />}
          {nextPost ? (
            <a href={`/blog/${nextPost.slug}`} class="nav-link" style="font-size: 0.875rem; text-align: right;" rel="next">
              {nextPost.data.title} →
            </a>
          ) : <span />}
        </div>
      </nav>
    )}
  </article>
</BaseLayout>
